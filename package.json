{
  "name": "telluslab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node serve.mjs",
    "test": "npm run build && node --test",
    "verify:git": "node scripts/verify-git-index.mjs",
    "lint": "node scripts/lint.mjs && npm run backlog:lint -- --file docs/BACKLOG.md && npm run content:lint",
    "content:lint": "node scripts/content-lint.mjs",
    "content:coverage": "node scripts/content-lint.mjs --coverage",
    "backlog:lint": "node scripts/backlog.mjs lint",
    "backlog:next": "node scripts/backlog.mjs next",
    "typecheck": "tsc --noEmit --strict --module nodenext --target es2022 packages/tellus-bridge/index.d.mts packages/content-schema/index.d.mts",
    "bridge:sync": "npm run build && node scripts/bridge-parity.mjs --sync",
    "bridge:verify": "npm run build && node scripts/bridge-parity.mjs",
    "domains:validate": "npm run build"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.1",
    "@highlightjs/cdn-assets": "11.11.1",
    "katex": "0.16.21",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "jsonc-parser": "3.3.1",
    "typescript": "5.9.3"
  }
}
