{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telluslab.local/content-schema/source.schema.json",
  "title": "Registro de fontes e licenças (content/sources/registry.json)",
  "type": "object",
  "required": ["kind", "schemaVersion", "sources"],
  "additionalProperties": false,
  "properties": {
    "kind": {"type": "string", "const": "TellusSourceRegistryV1"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "title", "url", "license", "attribution", "verifiedAt"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/sourceRegistryId"},
        "title": {"$ref": "common.schema.json#/$defs/text"},
        "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "license": {"$ref": "common.schema.json#/$defs/license"},
        "licenseNote": {"$ref": "common.schema.json#/$defs/text"},
        "attribution": {"$ref": "common.schema.json#/$defs/text"},
        "verifiedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  }
}
