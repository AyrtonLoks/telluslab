{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telluslab.local/content-schema/card.schema.json",
  "title": "Cartões FSRS de um macrotema (content/<slug>/<n.n>/cartoes.json)",
  "type": "object",
  "required": ["kind", "schemaVersion", "node", "cards"],
  "additionalProperties": false,
  "properties": {
    "kind": {"type": "string", "const": "TellusCardSetV1"},
    "schemaVersion": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "node": {"$ref": "common.schema.json#/$defs/nodeId"},
    "cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/card"}}
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": ["id", "revision", "front", "back", "directions", "schedule", "sources", "review", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/cardId"},
        "revision": {"$ref": "common.schema.json#/$defs/revision"},
        "status": {"$ref": "common.schema.json#/$defs/status"},
        "lesson": {"$ref": "common.schema.json#/$defs/lessonId"},
        "front": {"$ref": "common.schema.json#/$defs/text"},
        "back": {"$ref": "common.schema.json#/$defs/text"},
        "directions": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "enum": ["recognition", "production"]}},
        "schedule": {"type": "string", "enum": ["mastery", "lesson"]},
        "sources": {"$ref": "common.schema.json#/$defs/sources"},
        "license": {"$ref": "common.schema.json#/$defs/license"},
        "review": {"$ref": "common.schema.json#/$defs/review"},
        "provenance": {"$ref": "common.schema.json#/$defs/provenance"}
      },
      "if": {"properties": {"schedule": {"const": "lesson"}}, "required": ["schedule"]},
      "then": {"required": ["lesson"]}
    }
  }
}
